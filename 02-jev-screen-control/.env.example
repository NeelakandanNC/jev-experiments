# Planner LLM + OpenAI decision model (gpt-6-luna) + LLM baselines, via OpenAI directly
OPENAI_API_KEY=

# Jev, via OpenRouter's Decisions API ...
OPENROUTER_API_KEY=
SCREENJEV_JEV_VIA=openrouter
# ... or via Vercel AI Gateway (needs paid gateway credits for Jev)
AI_GATEWAY_API_KEY=

# Optional
# SCREENJEV_PLANNER_MODEL=gpt-6-luna      # planner LLM (any OpenAI model, or provider/model via the gateway)
# SCREENJEV_LLM_PRICE=0.10,0.40           # $ per 1M input,output tokens, for cost columns of chat calls
# SCREENJEV_YOLO_WEIGHTS=models/screenjev-yolo.pt
# CHROMIUM_PATH=/path/to/chrome           # if Playwright's own Chromium isn't installed
# HF_TOKEN=                               # only if Hugging Face rate-limits the ScreenSpot / OmniParser download
