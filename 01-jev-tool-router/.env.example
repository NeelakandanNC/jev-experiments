# OpenAI decision model (gpt-6-luna) via OpenAI's Decisions API
OPENAI_API_KEY=

# Jev, either via OpenRouter's Decisions API (what the published results used) ...
OPENROUTER_API_KEY=
JEVROUTE_JEV_VIA=openrouter
# ... or via Vercel AI Gateway (needs paid gateway credits for Jev)
AI_GATEWAY_API_KEY=

# Optional: only these models may use the gateway key (comma-separated), e.g. typesafe-ai/jev
# JEVROUTE_GATEWAY_ALLOW=typesafe-ai/jev
# Note: Jev on AI Gateway needs paid gateway credits (free tier returns 403).

# Optional override for the OpenAI decision model slug
# JEVROUTE_OPENAI_DECISION_MODEL=openai/gpt-6-luna

# --- only for end-to-end runs (bench/e2e.py), per benchmark -----------------------------
# MCP-Atlas key-gated servers: see vendor/mcp-atlas/env.template
# MCP-Bench: NPS_API_KEY, NASA_API_KEY, HF_TOKEN, GOOGLE_MAPS_API_KEY, NCI_API_KEY (vendor/mcp-bench/mcp_servers/api_key)
# MCP-Universe: SERP_API_KEY, GOOGLE_MAPS_API_KEY, GITHUB_PERSONAL_ACCESS_TOKEN, GITHUB_PERSONAL_ACCOUNT_NAME
