# Required: Vercel AI Gateway key. Jev and OpenAI's decision model are both called through
# the OpenAI-compatible Decisions API at https://ai-gateway.vercel.sh/v1/decisions
AI_GATEWAY_API_KEY=

# Optional override for the OpenAI decision model slug
# JEVROUTE_OPENAI_DECISION_MODEL=openai/gpt-6-luna-decisions

# --- only for end-to-end runs (bench/e2e.py), per benchmark -----------------------------
# MCP-Atlas key-gated servers: see vendor/mcp-atlas/env.template
# MCP-Bench: NPS_API_KEY, NASA_API_KEY, HF_TOKEN, GOOGLE_MAPS_API_KEY, NCI_API_KEY (vendor/mcp-bench/mcp_servers/api_key)
# MCP-Universe: SERP_API_KEY, GOOGLE_MAPS_API_KEY, GITHUB_PERSONAL_ACCESS_TOKEN, GITHUB_PERSONAL_ACCOUNT_NAME
